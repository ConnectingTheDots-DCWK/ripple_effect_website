---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import {
  documents,
  entryId,
  effectiveClause,
  isPending,
  legal,
  stampNote,
} from "../../manifest";

/**
 * A version, pinned.
 *
 * Every version of every document gets one of these, including the one
 * currently in force, and the promise attached to a *frozen* one is that it
 * never changes again. That is what makes "you accepted version 1.0 on 15
 * October" a statement somebody can check: the application records a version,
 * and this is the page that version resolves to for as long as the record is
 * worth anything.
 *
 * **The promise is conditional, and the page says which it is.** A version
 * nobody has accepted and that has not been declared final may still be
 * corrected — that is the point of `frozen` in the manifest, and ADR
 * *a-licence-follows-the-product*. Printing "this will not change" over a
 * version that can is the one sentence this page must never contain, because
 * it is the sentence a reader would rely on.
 *
 * The path is built from the manifest's `path` rather than composed here, so
 * there is exactly one spelling of it and the application's snapshot can
 * compare against the same string.
 */
export function getStaticPaths() {
  return documents.flatMap((document) =>
    document.versions.map((version) => ({
      // `path` is `v/eula-1.0`; this route owns everything after `v/`.
      params: { frozen: version.path.replace(/^v\//, "") },
      props: { document, version },
    })),
  );
}

const { document, version } = Astro.props;
const entry = await getEntry("documents", entryId(document.slug, version.version));
if (!entry) {
  throw new Error(
    `legal: ${document.slug} ${version.version} is in the manifest but ${version.source} does not exist`,
  );
}
const { Content } = await render(entry);

const isCurrent = version.version === document.current;
---

<Base
  title={`${document.title} v${version.version}`}
  description={document.summary}
  current={document.slug}
  archived={!isCurrent}
  canonical={`${legal.origin}/${document.slug}/`}
>
  <h1 class="title">{document.title}</h1>
  <p class="standfirst">{document.summary}</p>

  <p
    class={
      /*
       * `stamp--pending` says "not in force yet", so it belongs to the one
       * state that is: a future-dated version that nobody is bound by.  An
       * unfrozen version that *is* in force gets the plain stamp, and
       * `stampNote` is what says it can still be corrected.
       */
      !version.frozen && isPending(version) ? "stamp stamp--pending" : "stamp"
    }
  >
    <b>Version {version.version}</b> — {effectiveClause(version)}{" "}
    {stampNote(version)}
    <br />
    {
      /*
       * "Current" and "in force" are not the same thing and must not be
       * written as though they were. `current` is the version this slug
       * renders; whether it binds anybody is what `effectiveOn` decides, and
       * for an unfrozen version the answer is not yet. Saying "the version in
       * force" here put that claim two sentences away from its own
       * contradiction.
       */
      isCurrent ? (
        <>
          It is also the current version — the one{" "}
          <a href={`/${document.slug}/`}>
            {legal.origin}/{document.slug}/
          </a>{" "}
          renders.
        </>
      ) : (
        <>
          <b>This version has been superseded.</b> The current one is version{" "}
          {document.current}, at{" "}
          <a href={`/${document.slug}/`}>
            {legal.origin}/{document.slug}/
          </a>
          .
        </>
      )
    }
  </p>

  <div class="prose">
    <Content />
  </div>
</Base>
