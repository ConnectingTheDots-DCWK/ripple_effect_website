---
import Base from "../layouts/Base.astro";
import { documents, versionOf, effectiveShort } from "../manifest";

const now = new Date();
---

<Base
  title="Legal"
  description="The agreements and notices that govern Ripple Effect, the website and the hosted service."
>
  <h1 class="title">Legal</h1>
  <p class="standfirst">
    The agreements and notices that govern Ripple Effect. Each one has a link
    that never changes and, underneath it, a copy of every version that has ever
    been in force — so a version you accepted stays where it was.
  </p>

  <ul class="cards">
    {
      documents.map((document) => {
        const version = versionOf(document, document.current);
        return (
          <li>
            <a href={`/${document.slug}/`}>
              <h2>{document.title}</h2>
              <p>{document.summary}</p>
              <small>
                Version {document.current} · {effectiveShort(version, now)}
              </small>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
