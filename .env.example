# Copy to .env.local for local development, and set the same keys in Vercel.

# A fine-grained personal access token with the ConnectingTheDots-DCWK
# organisation as its resource owner, scoped to ConnectingTheDots-DCWK/ripple_effect
# ALONE, with `Contents: read` and nothing else.
#
# Releases are cut on that repository and it is private, so the download page
# has no public URL to link to and asks GitHub on the visitor's behalf. This is
# read server-side only: it must NEVER gain a NEXT_PUBLIC_ prefix, which would
# inline it into the browser bundle.
#
# Leave it unset and the site still builds — /download draws its four platforms
# in the "not published yet" state, which is worth looking at anyway.
RIPPLE_EFFECT_EDITOR_RELEASES=

# A fine-grained personal access token with the ConnectingTheDots-DCWK
# organisation as its resource owner and no permissions beyond metadata. The
# contributor list and /api/engine read public repositories with it, for the
# rate limit, and work without it. Never the token above: that one can read a
# private repository and is used for nothing else.
RIPPLE_EFFECT_METADATA=

# The hosted form the paid-tier waitlist button opens. site-config already has
# the live one as its default, so this only exists to point it somewhere else.
# Set it empty and the pricing card says there is nothing to sign up to yet.
NEXT_PUBLIC_WAITLIST_URL=
