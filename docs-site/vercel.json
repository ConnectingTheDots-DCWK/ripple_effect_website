{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!it/|it$|_astro/|pagefind/|overviews/|setup/)(?!.*\\.[A-Za-z0-9]+$).*)",
      "has": [
        { "type": "header", "key": "x-vercel-ip-country", "value": { "re": "^(IT|SM|VA)$" } }
      ],
      "missing": [
        {
          "type": "header",
          "key": "referer",
          "value": { "re": "^https://(docs\\.ripplefx\\.app|[^/]+\\.vercel\\.app)/" }
        }
      ],
      "destination": "/it/:path",
      "permanent": false
    }
  ]
}
